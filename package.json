{
	"name": "mcode-mcp",
	"publishConfig": {
		"access": "public"
	},
	"version": "0.4.0",
	"description": "MCP server that delegates coding tasks to your locally installed MiniMax Code CLI (mcode). Wraps the real mcode binary instead of bundling its own copy of the agent, so it inherits your MiniMax login, models and config.",
	"type": "module",
	"bin": {
		"mcode-mcp": "dist/index.js"
	},
	"main": "dist/index.js",
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
		"clean": "rm -rf dist",
		"prepare": "npm run build",
		"hooks": "git config core.hooksPath .githooks",
		"check": "npm run check:format && npm run check:types && npm test",
		"check:format": "biome check .",
		"check:types": "tsc --noEmit -p tsconfig.json",
		"fix": "biome check --write .",
		"test": "vitest run --typecheck",
		"test:live": "MCODE_CLI_MCP_LIVE=1 vitest run --config ./vitest.config.ts test/live.test.ts",
		"test:watch": "vitest --typecheck",
		"prepublishOnly": "npm run clean && npm run build && npm run check"
	},
	"engines": {
		"node": ">=22"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"mcode",
		"minimax-code",
		"coding-agent",
		"subagent",
		"delegation"
	],
	"author": "Karataev Pavel (https://github.com/minmax)",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@types/node": "^24.0.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/minmax/mcode-mcp.git"
	},
	"homepage": "https://github.com/minmax/mcode-mcp#readme",
	"bugs": "https://github.com/minmax/mcode-mcp/issues"
}
